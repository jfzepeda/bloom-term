# === Base de datos ===
# docker compose la inyecta solo; esto es para desarrollo local sin docker
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@localhost:5432/sentinel

# === Anthropic (único costo del sistema) ===
# Sin key: los agentes IA se omiten (jobs quedan 'skipped') y el resto funciona igual
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_TOKENS=2000

# === Umbrales de alertas (sección 6 del diseño) ===
ALERT_DROP_PCT=-7
ALERT_SPIKE_PCT=10
DRAWDOWN_THRESHOLDS=-30,-50,-70
RALLY_THRESHOLDS=50,100,150
THRESHOLD_RESET_BUFFER_PP=5
PIVOT_WINDOW_DAYS=60

# === DCF conservador (sección 5, Nivel 1) ===
DCF_DISCOUNT_RATE=0.10
DCF_TERMINAL_GROWTH=0.025
DCF_GROWTH_CAP=0.15
DCF_MARGIN_OF_SAFETY=0.30
DCF_HORIZON_YEARS=10

# === Ingestión ===
PRICE_BATCH_SIZE=100
PRICE_HISTORY_PERIOD=10y
FUNDAMENTALS_BATCH_PER_DAY=100
MIN_UNIVERSE_ROWS=480
BENCHMARK_SYMBOL=^GSPC

MARKET_TIMEZONE=America/New_York
CORS_ORIGINS=*
